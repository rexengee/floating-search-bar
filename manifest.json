{
  "manifest_version": 3,
  "name": "Floating Search Bar",
  "version": "1.1.3",
  "description": "Opens a centered floating search bar inside the active tab and switches to or opens a new tab on restricted pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Floating Search Bar"
  },
  "permissions": ["search", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-search-bar": {
      "description": "Toggle Floating Search Bar (switches to or opens a new tab on restricted pages)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}